{
  "name": "@aibuddy/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for aibuddy",
  "bin": {
    "aibuddy": "./dist/aibuddy.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/aibuddy.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/aibuddy-cli run build --filter=!@aibuddy/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@aibuddy/adapters": "workspace:*",
    "@aibuddy/bootstrap": "workspace:*",
    "@aibuddy/contracts": "workspace:*",
    "@aibuddy/core": "workspace:*",
    "@aibuddy/dynamic-workflow-runtime": "workspace:*",
    "@aibuddy/i18n": "workspace:*",
    "@aibuddy/provider-node": "workspace:*",
    "@aibuddy/shared": "workspace:*",
    "@aibuddy/shared-types": "workspace:*",
    "@aibuddy/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
